@"
# Local documents and results - never upload
data/
output/

# Uncomment to keep the test documents off GitHub too:
# tests/data/

# Virtual environment (large, PC-specific; recreate with requirements.txt)
.venv/
pyvenv.cfg

# Generated files
__pycache__/
*.pyc
build/
dist/

# Office lock files (created while a file is open)
~`$*
"@ | Set-Content -Path .gitignore -Encoding ascii
